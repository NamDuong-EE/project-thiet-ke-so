set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name TOP_LEVEL_ENTITY vending_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vending_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/button_conditioner.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/seven_segment.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vending_top.sv
set_global_assignment -name SDC_FILE vending_machine.sdc
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
source step_max10_pins.qsf
set_location_assignment PIN_J5 -to clk_12mhz
set_location_assignment PIN_J12 -to sw[0]
set_location_assignment PIN_H11 -to sw[1]
set_location_assignment PIN_H12 -to sw[2]
set_location_assignment PIN_H13 -to sw[3]
set_location_assignment PIN_J9 -to key[0]
set_location_assignment PIN_K14 -to key[1]
set_location_assignment PIN_J11 -to key[2]
set_location_assignment PIN_J14 -to key[3]
# LED/RGB locations are loaded from step_max10_pins.qsf above.
# Do not duplicate old locations here: later assignments override the include.
set_location_assignment PIN_E1 -to seg_tens[6]
set_location_assignment PIN_D2 -to seg_tens[5]
set_location_assignment PIN_K2 -to seg_tens[4]
set_location_assignment PIN_J2 -to seg_tens[3]
set_location_assignment PIN_G2 -to seg_tens[2]
set_location_assignment PIN_F5 -to seg_tens[1]
set_location_assignment PIN_G5 -to seg_tens[0]
set_location_assignment PIN_L1 -to dp_tens
set_location_assignment PIN_E2 -to digit_tens
set_location_assignment PIN_A3 -to seg_ones[6]
set_location_assignment PIN_A2 -to seg_ones[5]
set_location_assignment PIN_P2 -to seg_ones[4]
set_location_assignment PIN_P1 -to seg_ones[3]
set_location_assignment PIN_N1 -to seg_ones[2]
set_location_assignment PIN_C1 -to seg_ones[1]
set_location_assignment PIN_C2 -to seg_ones[0]
set_location_assignment PIN_R2 -to dp_ones
set_location_assignment PIN_B1 -to digit_ones
# Select the exact part in Assignments > Device before fitting/programming.
# build_quartus.ps1 -Device <part> writes a DEVICE assignment into this file.

set_global_assignment -name LAST_QUARTUS_VERSION "20.1.0 Lite Edition"
set_global_assignment -name DEVICE 10M02SCM153I7G

set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name DEVICE_FILTER_PACKAGE MBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 153
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 7
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (SystemVerilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "SYSTEMVERILOG HDL" -section_id eda_simulation
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
